@{
    ViewBag.Title = "OvertimeRequest";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-12 grid-margin">
            <div class="row">
                <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                    <h3 class="font-weight-bold">Overtime Request Form</h3>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 grid-margin stretch-card" style="justify-content:center;">
                    <div class="card">
                        <div class="card-body d-flex flex-column justify-content-between" style="height: 100%;">
                            <form class="forms-sample d-flex flex-column" style="flex-grow: 1;">
                                <div class="form-group">
                                    <label for="leaveStart" class="mb-2">Overtime Date:</label> <!-- Adjusted gap -->
                                    <div>
                                        <input type="date" class="form-control mb-lg-3" id="leaveStart" placeholder="dd/mm/yyyy">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="leaveEnd" class="mb-lg-2">Overtime Start:</label> <!-- Adjusted gap -->
                                    <input type="time" class="form-control mb-lg-3" />
                                </div>
                                <div class="form-group">
                                    <label for="leaveType" class="mb-2">Overtime End:</label> <!-- Adjusted gap -->
                                    <input type="time" class="form-control" />
                                </div>
                                <div class="mt-auto d-flex justify-content-center">
                                    <button type="submit" class="btn btn-primary mr-2">Submit</button>
                                    <button class="btn btn-light" id="clearForm">Reset</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-8 grid-margin stretch-card">
                    <div class="card">
                        <div class="card-body d-flex flex-column align-items-center">
                            <!-- 🔍 Search Bar -->
                            <input type="text" id="searchInput" class="form-control mb-3" placeholder="Search..." style="width: 100%; max-width: 100%;">
                            <div class="table-responsive">
                                <table class="table table-striped table-borderless text-center">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Overtime Start</th>
                                            <th>Overtime End</th>
                                            <th>Approval Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 1; i <= 4; i++)
                                        {
                                            <tr>
                                                <td>21 Sep 2018</td>
                                                <td>5:00 P.M</td>
                                                <td>8:00 P.M</td>
                                                <td class="font-weight-medium"><div class="badge badge-success">Approved</div></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                             <!-- Button at Bottom with More Spacing -->
                                <!-- Increased margin-top and padding-top -->
                                <button type="button" class="btn btn-primary btn-rounded btn-icon">
                                    <i class="ti-arrow-right"></i>
                                </button>
                        </div>
                    </div>
                </div>
            </div>
            <style>
                .table-responsive {
                    max-height: 500px;
                    overflow-y: auto;
                    width: 100%;
                }
            </style>
        </div>
    </div>
</div>
<script>
    // 🔍 Optimized Search Functionality with Reset
    document.getElementById("searchInput").addEventListener("keyup", function () {
        let filter = this.value.toLowerCase().trim();

        if (filter === "") {
            // If search is cleared, reset to original list
            rows = [...allRows];
        } else {
            // Filter rows based on search input
            rows = allRows.filter(row => row.innerText.toLowerCase().includes(filter));
        }

        currentPage = 1; // Reset to first page
        displayPage(currentPage);
    });
</script>


@{
    ViewBag.Title = "DTRHistory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card-body">
    <h2>Daily Time Record</h2>
    <div class="table-responsive" style="text-align:center;">
        <table class="table table-striped table-borderless">
            <thead>
                <tr>
                    <th rowspan="2">Date</th>
                    <th colspan="2" class="text-center">Morning</th>
                    <th colspan="2" class="text-center">Afternoon</th> 
                </tr>
                <tr>
                    <th>Time In</th>
                    <th>Time Out</th>
                    <th>Time In</th>
                    <th>Time Out</th>
                    <th>Work Mode</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 1; i <= 10; i++)
                {
                    <tr>
                        <td>21 Sep 2018</td>
                        <td class="font-weight-bold">08:00 AM</td>
                        <td>12:00 PM</td>
                        <td>01:00 PM</td>
                        <td>05:00 PM</td>
                        <td>Onsite</td>                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



